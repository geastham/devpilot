# Database
DATABASE_URL="postgresql://user:password@localhost:5432/devpilot?schema=public"
DEVPILOT_SQLITE_PATH=".devpilot/data.db"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Wave Planner Configuration
WAVE_PLANNER_ENABLED=true
WAVE_PLANNER_MAX_CONCURRENCY=4
WAVE_PLANNER_MAX_TOTAL_ACTIVE=8
WAVE_PLANNER_DISPATCH_DELAY_MS=500
WAVE_PLANNER_ADVANCE_DELAY_MS=2000
WAVE_PLANNER_RETRY_LIMIT=1
WAVE_PLANNER_FAILURE_POLICY=halt
WAVE_PLANNER_AUTO_ADVANCE=true
WAVE_PLANNER_MIN_PARALLELIZATION=0.3

# Standard tier — used for everyday wave plan generation.
WAVE_PLANNER_MODEL=claude-sonnet-4-20250514
WAVE_PLANNER_MAX_TOKENS=8192

# Ultra tier (ULTRAPLAN-style escalation).
#
# When WAVE_PLANNER_ULTRA_MODEL is set, the refinement service will escalate
# hard items to this model after the standard tier fails to clear
# WAVE_PLANNER_MIN_PARALLELIZATION. The ultra tier uses extended thinking;
# WAVE_PLANNER_ULTRA_THINKING_BUDGET is the token budget reserved for the
# thinking phase (must be strictly less than WAVE_PLANNER_ULTRA_MAX_TOKENS).
#
# Users can also opt into the ultra tier directly from the UI via the
# "Ultra plan" button on RefiningCard, which bypasses the standard tier.
WAVE_PLANNER_ULTRA_MODEL=claude-opus-4-6
WAVE_PLANNER_ULTRA_MAX_TOKENS=20000
WAVE_PLANNER_ULTRA_THINKING_BUDGET=16000
WAVE_PLANNER_ESCALATE_ON_FAILURE=true

# Anthropic API (for wave plan generation)
ANTHROPIC_API_KEY=your-api-key-here