# Database
DATABASE_URL="postgresql://user:password@localhost:5432/devpilot?schema=public"
DEVPILOT_SQLITE_PATH=".devpilot/data.db"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Wave Planner Configuration
WAVE_PLANNER_ENABLED=true
WAVE_PLANNER_MAX_CONCURRENCY=4
WAVE_PLANNER_MAX_TOTAL_ACTIVE=8
WAVE_PLANNER_DISPATCH_DELAY_MS=500
WAVE_PLANNER_ADVANCE_DELAY_MS=2000
WAVE_PLANNER_RETRY_LIMIT=1
WAVE_PLANNER_FAILURE_POLICY=halt
WAVE_PLANNER_AUTO_ADVANCE=true
WAVE_PLANNER_MIN_PARALLELIZATION=0.3
WAVE_PLANNER_MODEL=claude-sonnet-4-20250514
WAVE_PLANNER_MAX_TOKENS=8192

# Anthropic API (for wave plan generation)
ANTHROPIC_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Hosted bridge (OPTIONAL)
#
# DevPilot runs fully offline with none of these set. The bridge only adds a
# public Linear webhook endpoint, multi-machine routing, and a web dashboard.
# Agents always execute locally either way — the hosted plane never runs them.
#
# Point DEVPILOT_BRIDGE_URL at devpilot.sh, or at your own conforming bridge:
# the wire contract is published as @devpilot.sh/bridge-protocol (MIT).
# ---------------------------------------------------------------------------
DEVPILOT_BRIDGE_URL=""
# Minted in the dashboard under Settings -> Tokens. Shown once. Treat as a
# secret; it is stored server-side only as a SHA-256 hash.
DEVPILOT_BRIDGE_TOKEN=""
# realtime | poll. Defaults to realtime with automatic fallback to poll.
DEVPILOT_BRIDGE_TRANSPORT="realtime"