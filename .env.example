# Database
DATABASE_URL="postgresql://user:password@localhost:5432/devpilot?schema=public"
DEVPILOT_SQLITE_PATH=".devpilot/data.db"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Wave planner. Every line is optional; what is shown is the default.
#
# The model is left to its default on purpose. This file used to pin a model
# id that has since been retired, so copying it produced a planner that
# answered every request with a 404.
# WAVE_PLANNER_MODEL=claude-opus-5
#
# The output ceiling covers the model's thinking as well as the plan.
# WAVE_PLANNER_MAX_TOKENS=16000
#
# A plan of four or more tasks whose parallelization score is below this is
# sent back for refinement. A ratio from 0 to 1.
# WAVE_PLANNER_MIN_PARALLELIZATION=0.3
#
# The cockpit records every planner call and review in its own database
# (docs/PLANNER.md). The record stays on this machine. Set to 0 to record
# nothing.
# DEVPILOT_PLANNER_TRACE=1
#
# When a run ends, the bridge sends the hosted plane the plan's figures —
# counts, durations and cost; no text, no paths. Set to 0 to send none.
# DEVPILOT_PLANNER_FIGURES=1

# Wave execution.
# DEVPILOT_WAVE_MAX_CONCURRENT=4
# DEVPILOT_WAVE_MAX_TOTAL=8
# DEVPILOT_WAVE_RETRY_LIMIT=1
# DEVPILOT_WAVE_FAILURE_POLICY=halt
# DEVPILOT_WAVE_AUTO_ADVANCE=true

# Anthropic API (for wave plan generation)
ANTHROPIC_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Hosted bridge (OPTIONAL)
#
# DevPilot runs fully offline with none of these set. The bridge only adds a
# public Linear webhook endpoint, multi-machine routing, and a web dashboard.
# Agents always execute locally either way — the hosted plane never runs them.
#
# Point DEVPILOT_BRIDGE_URL at devpilot.sh, or at your own conforming bridge:
# the wire contract is published as @devpilot.sh/bridge-protocol (MIT).
# ---------------------------------------------------------------------------
DEVPILOT_BRIDGE_URL=""
# Minted in the dashboard under Settings -> Tokens. Shown once. Treat as a
# secret; it is stored server-side only as a SHA-256 hash.
DEVPILOT_BRIDGE_TOKEN=""
# realtime | poll. Defaults to realtime with automatic fallback to poll.
DEVPILOT_BRIDGE_TRANSPORT="realtime"